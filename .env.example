APP_NAME=app
AWS_ACCESS_KEY_ID=access
AWS_ENDPOINT_URL_LOCAL=true
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=secretsecret
CSP_ALLOW_UNSAFE_INLINE=false
DATABASE_PATH=app.db
# The email address of the group's first admin. While the group has nobody in it, this address can ask for
# a sign-in link, and on first signing in chooses a name and joins as admin. Once anyone has joined,
# changing it removes and demotes nobody, and lets nobody new in. Empty means nobody can join this way.
FIRST_ADMIN_EMAIL=
# The group's name. Empty means "Our group", or "The Loft" in the preview build.
GROUP_NAME=
# The IANA time zone the timeline is grouped into days in, such as Europe/Copenhagen. Empty means UTC.
GROUP_TIME_ZONE=Europe/Copenhagen
JOB_QUEUE_TIMEOUT=10s
LOG_JSON=false
LOG_LEVEL=debug
LOG_NO_TIME=true
MARKETING_EMAIL_ADDRESS=marketing@example.com
MARKETING_EMAIL_NAME=Marketing
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=123
POSTMARK_KEY=123
REPLY_TO_EMAIL_ADDRESS=support@example.com
REPLY_TO_EMAIL_NAME=app
S3_BUCKET_NAME=bucket
S3_PATH_STYLE=true
SECURE_COOKIE=false
SERVER_ADDRESS_LOCAL=true
TRANSACTIONAL_EMAIL_ADDRESS=support@example.com
TRANSACTIONAL_EMAIL_NAME=app
